<%- include('../partials/layout-inicio') %>
<div class="encabezado">
  <h2 class="encabezado__titulo">Registros de Compensación</h2>
</div>

<div class="card tabla-card">
  <form class="filtro" method="GET" action="/admin/registros">
    <label for="cedula" class="card__titulo">Funcionario</label>
    <div class="select select--pequeno">
      <select id="cedula" name="cedula" onchange="this.form.submit()">
        <option value="">Todos</option>
        <% funcionarios.forEach(f => { %>
          <option value="<%= f.cedula %>" <%= filtro === f.cedula ? 'selected' : '' %>><%= f.nombreCompleto %> — <%= f.cedula %></option>
        <% }) %>
      </select>
    </div>
    <noscript><button class="btn btn--primario btn--mediano">Filtrar</button></noscript>
  </form>

  <% if (registros.length) { %>
    <div class="tabla-scroll">
      <table class="tabla">
        <thead>
          <tr><th>Funcionario</th><th>C.C</th><th>Tipo</th><th>Fecha</th><th>Horas</th><th>Estado</th></tr>
        </thead>
        <tbody>
          <% registros.forEach(r => { %>
            <tr>
              <td><a class="tabla__link" href="/admin/funcionarios/<%= r.cedula %>"><%= r.nombreCompleto %></a></td>
              <td><%= r.cedula %></td>
              <td><%= tipos[r.tipo].nombre %></td>
              <td><%= fechaLarga(r.fecha) %></td>
              <td><%= tipos[r.tipo].horas %></td>
              <td><span class="estado estado--<%= r.estado %>"><%= r.estado === 'finalizada' ? 'Finalizada' : 'En curso' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="vacio">No hay registros de compensación.</p>
  <% } %>
</div>
<%- include('../partials/layout-fin') %>
