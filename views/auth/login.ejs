<%- include('../partials/head') %>
<body class="login">
  <div class="login__diagonal" aria-hidden="true"></div>
  <main class="login__contenido">
    <img class="login__logo" src="/img/logo.png" alt="Secretaría de Educación">
    <h1 class="login__titulo">Orientaciones Descanso Compensado</h1>
    <form class="login__form" action="/login" method="POST" novalidate>
      <label for="cedula" class="login__label">Ingresa tu Número de Identificación</label>
      <input class="login__input <%= error ? 'is-error' : '' %>" type="text" id="cedula" name="cedula"
        inputmode="numeric" pattern="[0-9]*" autocomplete="off" placeholder="C.C" value="<%= cedula %>" required autofocus>
      <p class="login__error" role="alert"><%= error || '' %></p>
      <button type="submit" class="btn btn--primario">Ingresar</button>
    </form>
  </main>
</body>
</html>
