<%- include('../partials/head') %>
<body class="pantalla">
  <main class="pantalla__contenido">
    <h1 class="pantalla__titulo">Inicio de Compensación</h1>
    <% if (!evaluacion.permitido) { %>
      <p class="pantalla__texto"><%= evaluacion.motivo %></p>
      <a href="<%= tipo === 'sabado' ? '/usuario/sabados' : '/usuario/dashboard' %>" class="btn btn--primario">Volver</a>
    <% } else { %>
      <% if (tipo === 'sabado') { %>
        <p class="pantalla__texto">
          Estás a punto de iniciar tu jornada de compensación de hoy, <%= fechaLegible(horario.fecha) %>,
          de <%= horaLegible(horario.horaInicio) %> a <%= horaLegible(horario.horaFin) %>
          (<%= numero(horario.horas) %> horas). Al terminar la jornada se habilita el botón 'Finalizar compensación':
          presiónalo entre las <%= horaLegible(horario.horaFin) %> y las <%= horaLegible(horario.finalizarHasta) %>.
          Si no lo haces a tiempo, el sábado no suma horas.
        </p>
      <% } else { %>
        <p class="pantalla__texto">
          Estás a punto de iniciar tu hora adicional de hoy, de <%= horaLegible(horario.horaInicio) %>
          a <%= horaLegible(horario.horaFin) %>. Sin importar a qué hora inicies, terminas a las
          <%= horaLegible(horario.horaFin) %>. Ahí se habilita el botón 'Finalizar compensación':
          presiónalo entre las <%= horaLegible(horario.horaFin) %> y las <%= horaLegible(horario.finalizarHasta) %>.
          Si no lo haces a tiempo, la hora no suma.
        </p>
      <% } %>
      <form action="/usuario/compensacion/iniciar" method="POST">
        <input type="hidden" name="tipo" value="<%= tipo %>">
        <button type="submit" class="btn btn--primario">Iniciar</button>
      </form>
      <a href="<%= tipo === 'sabado' ? '/usuario/sabados' : '/usuario/dashboard' %>" class="pantalla__volver">Cancelar</a>
    <% } %>
  </main>
</body>
</html>
