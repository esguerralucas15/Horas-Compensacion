<%- include('../partials/layout-inicio') %>
<section class="sabados">
  <h2 class="sabados__titulo">Compensación día sábado</h2>
  <p class="sabados__texto">
    Como alternativa a la reposición de tiempo en días hábiles, puedes solicitar la compensación en modalidad
    presencial los dias sábados, ten en cuenta que esta opción exige el cumplimiento de la jornada completa
    (excluyendo la hora de almuerzo) y está sujeta a la autorización previa de tu jefe inmediato según las
    necesidades del servicio.
  </p>

  <form class="card sabados__card" action="/usuario/sabados" method="POST">
    <label for="fecha" class="sabados__pregunta">Selecciona el dia sábado en que estás realizando tu compensación</label>
    <% const hayDisponibles = sabados.some(s => !s.compensado); %>
    <div class="select">
      <select id="fecha" name="fecha" required>
        <% let elegido = false; sabados.forEach(s => { const sel = !s.compensado && !elegido; if (sel) elegido = true; %>
          <option value="<%= s.valor %>" <%= s.compensado ? 'disabled' : '' %> <%= sel ? 'selected' : '' %>><%= s.texto %></option>
        <% }) %>
      </select>
    </div>
    <% if (error) { %><p class="login__error" role="alert"><%= error %></p><% } %>
    <% if (!hayDisponibles) { %><p class="login__error" role="alert">Ya compensaste todos los sábados habilitados.</p><% } %>
    <button type="submit" class="btn btn--primario btn--mediano" <%= hayDisponibles ? '' : 'disabled' %>>Iniciar Compensación</button>
  </form>
</section>
<%- include('../partials/layout-fin') %>
