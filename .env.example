# Copia este archivo como .env y reemplaza los valores entre < >.
# El archivo .env tiene claves: nunca se sube a GitHub (está en .gitignore).

# Puerto del servidor
PORT=3000

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers).
# Usar el usuario de la aplicación (solo readWrite sobre horas_compensacion), no el administrador.
MONGODB_URI=mongodb+srv://<usuario>:<clave>@clustercompensacion.hqfmgjk.mongodb.net/horas_compensacion?retryWrites=true&w=majority&appName=Clustercompensacion

# Clave para firmar la cookie de sesión: una cadena aleatoria larga.
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<cadena-aleatoria-larga>
